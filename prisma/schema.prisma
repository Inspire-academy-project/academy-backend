generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student        Student? @relation("StudentAccount")
  uploadedVideos Video[]  @relation("VideoUploader")
}

enum Gender {
  MALE
  FEMALE
}

model Student {
  id             Int      @id @default(autoincrement())
  seatNo         String?  @unique
  name           String
  gender         Gender?
  course         String?
  className      String?
  phone          String?
  parentPhone    String?
  attendanceCode String?  @unique
  enrolledAt     DateTime @db.Date
  leftAt         DateTime? @db.Date
  active         Boolean  @default(true)
  memo           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId Int?  @unique
  user   User? @relation("StudentAccount", fields: [userId], references: [id], onDelete: SetNull)

  attendances Attendance[]
  payments    Payment[]
  mealOrders  MealOrder[]
  mealRecords MealRecord[]

  @@index([active, gender])
  @@index([className])
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

model Attendance {
  id        Int              @id @default(autoincrement())
  studentId Int
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  checkInAt DateTime?
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([date])
}

enum FeeType {
  TUITION
  MEAL
  OTHER
}

model BillingPeriod {
  id        Int      @id @default(autoincrement())
  feeType   FeeType  @default(TUITION)
  label     String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  dueDate   DateTime @db.Date
  baseAmount Int?
  closed    Boolean  @default(false)
  createdAt DateTime @default(now())

  payments Payment[]

  @@unique([feeType, label])
  @@index([startDate])
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  EXEMPT
}

model Payment {
  id           Int           @id @default(autoincrement())
  studentId    Int
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  periodId     Int
  period       BillingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  amount       Int
  paidAmount   Int           @default(0)
  status       PaymentStatus @default(UNPAID)
  proratedDays Int?
  paidAt       DateTime?
  memo         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([studentId, periodId])
  @@index([status])
}

enum MealType {
  LUNCH
  DINNER
}

/// 급식은 정액이 아니라 선불 식권제다. 월 단위로 신청 개수를 받아 결제하고,
/// 남은 개수는 다음 달로 이월(선결제)된다.
model MealOrder {
  id           Int           @id @default(autoincrement())
  studentId    Int
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  year         Int
  month        Int
  mealType     MealType
  orderedCount Int
  carriedOver  Int           @default(0)
  unitPrice    Int
  chargeCount  Int
  amount       Int
  method       String?
  status       PaymentStatus @default(UNPAID)
  paidAt       DateTime?
  memo         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([studentId, year, month, mealType])
  @@index([year, month, mealType])
  @@index([status])
}

/// 급식수령표에 손으로 O 표시하던 일별 수령 기록.
model MealRecord {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  mealType  MealType
  received  Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())

  @@unique([studentId, date, mealType])
  @@index([date, mealType])
}

/// 공휴일 등 급식을 운영하지 않는 날. 수령표에서 해당 칸을 비운다.
model MealServiceDay {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  mealType  MealType
  operating Boolean  @default(true)
  note      String?

  @@unique([date, mealType])
  @@index([date])
}

model Video {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  subject     String?
  problemDate DateTime? @db.Date
  filePath    String
  mimeType    String?
  sizeBytes   Int?
  uploaderId  Int
  uploader    User      @relation("VideoUploader", fields: [uploaderId], references: [id])
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([problemDate])
  @@index([createdAt])
}
