generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student        Student? @relation("StudentAccount")
  uploadedVideos Video[]  @relation("VideoUploader")
}

enum Gender {
  MALE
  FEMALE
}

/// 원비 할인 구분. 학생마다 월 원비가 달라지고, 일할 단가도 여기서 갈린다.
/// 얼리는 설 전 첫 등원생에게 적용되며 퇴원할 때까지 유지된다.
enum TuitionTier {
  STANDARD
  EARLY
  RETURNING
  REENROLLED
}

model Student {
  id             Int      @id @default(autoincrement())
  /// 좌석번호는 퇴원하면 다른 학생이 넘겨받는다. 재원생 중에서만 유일하므로
  /// DB 제약이 아니라 애플리케이션에서 검사한다. 학생 식별자는 id 를 쓴다.
  seatNo         String?
  name           String
  gender         Gender?
  course         String?
  className      String?
  phone          String?
  parentPhone    String?
  attendanceCode String?  @unique
  tuitionTier    TuitionTier @default(STANDARD)
  monthlyFee     Int         @default(680000)
  enrolledAt     DateTime @db.Date
  leftAt         DateTime? @db.Date
  active         Boolean  @default(true)
  memo           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId Int?  @unique
  user   User? @relation("StudentAccount", fields: [userId], references: [id], onDelete: SetNull)

  attendances Attendance[]
  payments    Payment[]
  mealReservations MealReservation[]
  mealRecords      MealRecord[]
  mealSettlements  MealSettlement[]

  @@index([active, gender])
  @@index([className])
  @@index([seatNo])
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

model Attendance {
  id        Int              @id @default(autoincrement())
  studentId Int
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  checkInAt DateTime?
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([date])
}

enum FeeType {
  TUITION
  OTHER
}

model BillingPeriod {
  id        Int      @id @default(autoincrement())
  feeType   FeeType  @default(TUITION)
  label     String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  dueDate   DateTime @db.Date
  baseAmount Int?
  closed    Boolean  @default(false)
  createdAt DateTime @default(now())

  payments Payment[]

  @@unique([feeType, label])
  @@index([startDate])
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  EXEMPT
}

model Payment {
  id           Int           @id @default(autoincrement())
  studentId    Int
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  periodId     Int
  period       BillingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  amount       Int
  paidAmount   Int           @default(0)
  status       PaymentStatus @default(UNPAID)
  proratedDays Int?
  paidAt       DateTime?
  memo         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([studentId, periodId])
  @@index([status])
}

enum MealType {
  LUNCH
  DINNER
}

enum ReservationStatus {
  RESERVED
  CANCELLED
}

/// 급식은 후불이다. 날짜별로 신청하고 전날까지 취소할 수 있으며,
/// 월말에 실제 수령한 횟수만큼 정산해 청구한다.
model MealReservation {
  id          Int               @id @default(autoincrement())
  studentId   Int
  student     Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date        DateTime          @db.Date
  mealType    MealType
  status      ReservationStatus @default(RESERVED)
  cancelledAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([studentId, date, mealType])
  @@index([date, mealType, status])
}

/// 월별 후불 정산. 실제 수령 횟수 x 단가로 청구액이 정해진다.
model MealSettlement {
  id          Int           @id @default(autoincrement())
  studentId   Int
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  year        Int
  month       Int
  mealType    MealType
  servedCount Int
  unitPrice   Int
  amount      Int
  method      String?
  status      PaymentStatus @default(UNPAID)
  paidAt      DateTime?
  memo        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([studentId, year, month, mealType])
  @@index([year, month, mealType])
  @@index([status])
}

/// 급식수령표에 손으로 O 표시하던 일별 수령 기록.
model MealRecord {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  mealType  MealType
  received  Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())

  @@unique([studentId, date, mealType])
  @@index([date, mealType])
}

/// 공휴일 등 급식을 운영하지 않는 날. 수령표에서 해당 칸을 비운다.
model MealServiceDay {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  mealType  MealType
  operating Boolean  @default(true)
  note      String?

  @@unique([date, mealType])
  @@index([date])
}

model Video {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  subject     String?
  problemDate DateTime? @db.Date
  filePath    String
  mimeType    String?
  sizeBytes   Int?
  uploaderId  Int
  uploader    User      @relation("VideoUploader", fields: [uploaderId], references: [id])
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([problemDate])
  @@index([createdAt])
}
